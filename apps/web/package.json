{
	"name": "demotivator-web",
	"private": true,
	"version": "14.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite serve",
		"updateGuardian": "node -e \"const{spawnSync}=require('child_process'),p=require('os').platform();const r=p==='win32'?spawnSync('pwsh',['-File','../../scripts/updateGuardian.ps1'],{stdio:'inherit',shell:true}):spawnSync('zsh',['../../scripts/updateGuardian.sh'],{stdio:'inherit'});if(r.status!==0)process.exit(r.status||1);\"",
		"prebuild": "npm run updateGuardian && rm -rf out",
		"build": "vite build",
		"postbuild": "cp -r ../../www/* out/ && if [ -d ../docs/dist ]; then rm -rf out/docs && mkdir -p out/docs && cp -r ../docs/dist/* out/docs/; fi",
		"ssrBuild": "vite ssrBuild",
		"lint": "eslint \"./src/**/*.{js,ts,svelte}\" --fix --max-warnings=-1 || true",
		"buildTS": "tsc --project tsconfig.json",
		"typeCheck": "tsc --project tsconfig.json --noEmit",
		"supportedBrowsers": "(echo export default && browserslist-useragent-regexp --allowHigherVersions) > src/utils/supportedBrowsers.ts",
		"preview": "vite preview",
		"pushPrepareDocs": "npm --prefix ../docs run build && rm -rf out/docs && mkdir -p out/docs && cp -r ../docs/dist/* out/docs/",
		"push": "npm run pushPrepareDocs && npx firebase-tools deploy"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/postcss": "^4.2.1",
		"@tailwindcss/vite": "^4.2.1",
		"autoprefixer": "^10.4.27",
		"browserslist-useragent-regexp": "^4.1.3",
		"eslint": "^10.0.3",
		"eslint-plugin-import": "^2.32.0",
		"postcss": "^8.5.8",
		"rollup-plugin-visualizer": "^7.0.1",
		"sass": "^1.98.0",
		"serve": "^14.2.6",
		"svelte": "^5.53.11",
		"svelte-preprocess": "^6.0.3",
		"tailwindcss": "^4.2.1",
		"terser": "^5.46.0",
		"typescript": "^5.9.3",
		"vite": "^8.0.0"
	},
	"dependencies": {
		"@demotivator/shared": "^14.0.0",
		"@demotivator/ui": "^14.0.0",
		"@porkyproductions/hat": "^1.5.0",
		"bootstrap": "^5.3.8",
		"bootstrap-icons": "^1.13.1",
		"canvas-confetti": "^1.9.4",
		"demotivator": "^14.0.0",
		"firebase": "^12.10.0",
		"firebase-tools": "^15.8.0",
		"lodash": "^4.17.23",
		"uadetect": "^7.0.0-alpha-2"
	}
}
