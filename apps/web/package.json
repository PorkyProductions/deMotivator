{
	"name": "demotivator-web",
	"private": true,
	"version": "15.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite serve",
		"updateGuardian": "node -e \"const{spawnSync}=require('child_process'),p=require('os').platform();const r=p==='win32'?spawnSync('pwsh',['-File','../../scripts/updateGuardian.ps1'],{stdio:'inherit',shell:true}):spawnSync('zsh',['../../scripts/updateGuardian.sh'],{stdio:'inherit'});if(r.status!==0)process.exit(r.status||1);\"",
		"prebuild": "npm run updateGuardian && rm -rf out",
		"build": "vite build",
		"postbuild": "cp -r ../../www/* out/",
		"ssrBuild": "vite ssrBuild",
		"lint": "eslint \"./src/**/*.{js,ts,svelte}\" --fix --max-warnings=-1 || true",
		"buildTS": "tsc --project tsconfig.json",
		"typeCheck": "tsc --project tsconfig.json --noEmit",
		"supportedBrowsers": "(echo export default && browserslist-useragent-regexp --allowHigherVersions) > src/utils/supportedBrowsers.ts",
		"preview": "vite preview",
		"push": "npx firebase-tools deploy"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/postcss": "^4.2.0",
		"@tailwindcss/vite": "^4.2.0",
		"autoprefixer": "^10.4.24",
		"browserslist-useragent-regexp": "^4.1.3",
		"eslint": "^8.57.1",
		"eslint-config-airbnb-base": "^15.0.0",
		"eslint-plugin-import": "^2.32.0",
		"postcss": "^8.5.6",
		"rollup-plugin-visualizer": "^7.0.0",
		"sass": "^1.97.3",
		"serve": "^14.2.5",
		"svelte": "^5.53.0",
		"svelte-preprocess": "^6.0.3",
		"tailwindcss": "^4.2.0",
		"terser": "^5.46.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@demotivator/shared": "^15.0.0",
		"@porkyproductions/hat": "^1.5.0",
		"bootstrap": "^5.3.8",
		"bootstrap-icons": "^1.13.1",
		"canvas-confetti": "^1.9.4",
		"demotivator": "^15.0.0",
		"firebase": "^12.9.0",
		"firebase-tools": "^15.7.0",
		"lodash": "^4.17.23",
		"uadetect": "^7.0.0-alpha-2"
	}
}
