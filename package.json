{
  "name": "demotivator",
  "private": true,
  "version": "13.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite serve",
    "prebuild": "rm -rf out",
    "build": "vite build",
    "ssrBuild": "vite ssrBuild",
    "lint": "eslint ./src/* --fix",
    "buildTS": "tsc --project tsconfig.json",
    "typeCheck": "tsc --project tsconfig.json --noEmit",
    "supportedBrowsers": "(echo export default && browserslist-useragent-regexp --allowHigherVersions) > src/utils/supportedBrowsers.ts",
    "preview": "vite preview",
    "push-preview": "firebase demotivator-dev:deploy"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "autoprefixer": "^10.4.22",
    "browserslist-useragent-regexp": "^4.1.3",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "^1.93.2",
    "serve": "^14.2.5",
    "svelte": "^5.43.12",
    "svelte-preprocess": "^5.1.4",
    "tailwindcss": "^4.1.17",
    "terser": "^5.44.0",
    "typescript": "^5.9.2",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "@porkyproductions/hat": "^1.5.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "canvas-confetti": "^1.9.3",
    "demotivator": "^14.0.0",
    "firebase": "^9.23.0",
    "lodash": "^4.17.21",
    "uadetect": "^7.0.0-alpha-2"
  }
}
