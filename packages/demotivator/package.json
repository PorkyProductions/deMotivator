{
	"name": "demotivator",
	"version": "14.1.0",
	"description": "An extremely large, procedural insult generation system with 500+ insults.",
	"type": "module",
	"scripts": {
		"lint": "eslint ./source/** --fix",
		"lint:check": "eslint ./source/** --max-warnings=0",
		"build": "tsc -p tsconfig.json",
		"typeCheck": "tsc -p tsconfig.json --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PorkyProductions/deMotivator.git"
	},
	"keywords": [
		"dmv",
		"demotivator",
		"dmv.js",
		"demotivator.js",
		"insult",
		"insults",
		"insult array",
		"array"
	],
	"author": "PorkyProductions",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/PorkyProductions/deMotivator/issues"
	},
	"homepage": "https://demotivator.web.app",
	"devDependencies": {
		"@types/lodash": "^4.17.24",
		"eslint": "^10.8.0",
		"eslint-plugin-n": "^18.2.2",
		"eslint-plugin-promise": "^7.3.0",
		"typescript": "^7.0.2"
	},
	"files": [
		"./dist/**/*.js",
		"./dist/**/*.js.map",
		"./dist/**/*.d.ts",
		"./dist/**/*.d.ts.map"
	],
	"main": "./dist/index.js",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"displayName": "(de)Motivator.js",
	"contributors": [
		"Tristan Winata"
	],
	"maintainers": [
		"Ryan Mullin"
	],
	"types": "./dist/index.d.ts",
	"dependencies": {
		"lodash": "^4.17.23"
	}
}
