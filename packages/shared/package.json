{
	"name": "@demotivator/shared",
	"version": "14.1.0",
	"description": "Shared utility functions for the deMotivator monorepo.",
	"type": "module",
	"scripts": {
		"lint": "eslint ./source/** --fix",
		"lint:check": "eslint ./source/** --max-warnings=0",
		"build": "tsc -p tsconfig.json",
		"typeCheck": "tsc -p tsconfig.json --noEmit"
	},
	"author": "PorkyProductions",
	"license": "Apache-2.0",
	"devDependencies": {
		"@types/lodash": "^4.17.24",
		"eslint": "^10.5.0",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"lodash": "^4.17.23"
	},
	"files": [
		"./dist/**/*.js",
		"./dist/**/*.js.map",
		"./dist/**/*.d.ts",
		"./dist/**/*.d.ts.map"
	],
	"main": "./dist/index.js",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"types": "./dist/index.d.ts"
}
