{
	"name": "@demotivator/ui",
	"version": "14.0.0",
	"description": "Shared Svelte UI components for the deMotivator monorepo.",
	"type": "module",
	"scripts": {
		"lint": "eslint \"./source/**/*.{js,ts,svelte}\" --fix --max-warnings=-1 || true",
		"build": "vite build",
		"typeCheck": "tsc -p tsconfig.json --noEmit"
	},
	"author": "PorkyProductions",
	"license": "Apache-2.0",
	"peerDependencies": {
		"bootstrap": "^5.3.8",
		"svelte": "^5.53.7"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"eslint": "^10.1.0",
		"typescript": "^5.9.3",
		"vite": "^8.0.0"
	},
	"files": [
		"./source/**/*",
		"./dist/**/*"
	],
	"main": "./dist/index.js",
	"svelte": "./source/index.js",
	"exports": {
		".": {
			"svelte": "./source/index.js",
			"default": "./dist/index.js"
		}
	}
}
