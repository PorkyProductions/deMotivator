{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "daemon": true,
  "globalDependencies": [
    ".env",
    ".env.*",
    "tsconfig.json",
    "turbo.json",
    "package.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["lint", "prebuild", "^build"],
      "outputs": ["out/**", "dist/**", ".vite/**"],
      "cache": true,
      "inputs": [
        "src/**",
        "source/**",
        "public/**",
        "*.html",
        "vite.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputLogs": "new-only"
    },
    "prebuild": {
      "dependsOn": ["lint"],
      "outputs": [],
      "cache": true,
      "inputs": [
        "src/**",
        "source/**",
        "package.json"
      ],
      "outputLogs": "errors-only"
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": true,
      "inputs": [
        "src/**/*.{js,ts,svelte}",
        "source/**/*.{js,ts,svelte}",
        ".eslintrc.*",
        ".eslintignore"
      ],
      "outputLogs": "errors-only"
    },
    "typeCheck": {
      "dependsOn": ["^typeCheck"],
      "outputs": ["*.tsbuildinfo"],
      "cache": true,
      "inputs": [
        "src/**/*.{ts,tsx,svelte}",
        "source/**/*.{ts,tsx,svelte}",
        "tsconfig.json"
      ],
      "outputLogs": "errors-only"
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "inputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"],
      "cache": true,
      "inputs": [
        "src/**",
        "source/**",
        "test/**",
        "*.config.{js,ts}"
      ],
      "outputLogs": "new-only"
    }
  }
}
