{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["lint", "prebuild", "^build"],
      "outputs": ["out/**", "dist/**"]
    },
    "prebuild": {
      "dependsOn": ["lint"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typeCheck": {
      "dependsOn": ["^typeCheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    }
  }
}
